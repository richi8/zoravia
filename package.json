{
  "name": "zoravia",
  "version": "1.0.0",
  "description": "Browser monster-collecting RPG with code-generated Zorlings.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run world -- build && vite build",
    "preview": "vite preview",
    "world": "node tools/run.mjs tools/world/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "smoke": "npm run build && npm run smoke:run",
    "smoke:run": "node tools/run.mjs tools/smoke/cli.ts",
    "balance": "node tools/run.mjs tools/balance/cli.ts"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "pixi.js": "^8.23.0",
    "zod": "^4.6.7"
  }
}
